# ⭐ Vercel Environment Variables - මෙය .env.example ලෙස Save කරන්න

# Alchemy API Key (https://alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ⚠️ ඔබගේ Wallet Private Key (Gas ගෙවන්න)
PRIVATE_KEY=your_private_key_here

# Contract Address
CONTRACT_ADDRESS=0xb69E225117d428a0b349BAB76368c68012Df1837