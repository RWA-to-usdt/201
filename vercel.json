{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/**/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1",
            "methods": ["GET", "POST", "OPTIONS"]
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}